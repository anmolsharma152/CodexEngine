# --- 3-Tier Multi-Provider LLM Configuration (100% Zero-Cost Developer Tiers) ---

# Tier 1 (Primary Workhorse): Google Gemini (Free tier, 15 RPM / 1M TPM / 1500 RPD)
# Get key at https://aistudio.google.com/app/apikey (GEMINI_API_KEY or GOOGLE_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
PRIMARY_MODEL_NAME=gemini-2.5-flash

# Tier 2 (Secondary Fallback): Groq (Free tier, high-speed LPU, zero <think> tokens)
# Get key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_actual_api_key_here
GROQ_MODEL_NAME=openai/gpt-oss-120b

# Tier 3 (Tertiary Fallback): OpenRouter Free Tier (:free endpoints)
# Get key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL_NAME=google/gemma-4-31b-it:free

# --- Database & Vector Storage (Supabase Postgres with pgvector) ---
DB_URL="postgresql+psycopg://user:password@host:5432/dbname"

# --- Supabase Project Configuration ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Required for auto-creating the storage bucket on startup
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# --- Security & CORS Configuration ---
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app"

# --- Observability & Tracing (Langfuse - Optional) ---
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_HOST="https://cloud.langfuse.com"
